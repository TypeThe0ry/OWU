# JavaScript dependencies and package-manager state
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build, test, and local runtime output
/.next/
/.vinext/
/.wrangler/
/dist/
/out/
/coverage/
/outputs/
/work/
/.dev.pid
/dev.log
/dev.err.log
*.tsbuildinfo

# SwiftPM and Xcode user state
/.build/
/macos/.build/
/.swiftpm/
**/xcuserdata/
**/DerivedData/

# Local configuration and credentials. Examples remain tracked.
.env
.env.*
!.env.example
!**/*.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.htpasswd
known_hosts

# Logs, editors, and operating-system metadata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Provider-specific local state
.vercel/

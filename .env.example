# Web build: used for absolute Open Graph and Twitter card URLs.
NEXT_PUBLIC_OWU_BASE_URL=https://owu.example.com

# Public client listeners are configured in deploy/nginx-owu*.conf, not here.
# Shared host: TLS/WSS on 443, 8080, 8443, and 9443; port 80 redirects HTTP.
# Dedicated address: TLS/WSS on 443, 80, 8080, 8443, and 9443. Never send OWU
# credentials over plaintext ws:// fallbacks.

# Go data plane: copy these entries to /etc/owu/owu-proxy.env on the server.
OWU_PROXY_LISTEN_ADDR=127.0.0.1:3211
OWU_TRANSPORT_POOL_SIZE=64
OWU_MEDIA_CACHE_MAX_AGE=15m

# Generate a distinct value, for example: openssl rand -base64 48
# Do not reuse the Nginx Basic Auth password.
OWU_TUNNEL_KEY=replace-with-a-random-tunnel-key-at-least-20-characters

# The client sends only a resource ID; these destinations stay server-side.
OWU_TCP_RESOURCES=ssh=127.0.0.1:22,minecraft=mc.example.net:25565

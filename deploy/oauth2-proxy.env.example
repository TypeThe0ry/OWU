# OAuth2 Proxy is the SSO edge for OWU. Keep it bound to loopback; only Nginx
# should be reachable from the public network.
OAUTH2_PROXY_HTTP_ADDRESS=127.0.0.1:4180
OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_PROVIDER_DISPLAY_NAME=GitHub
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1/32
OAUTH2_PROXY_REAL_CLIENT_IP_HEADER=X-Real-IP
OAUTH2_PROXY_REDIRECT_URL=https://owu.example.com/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=owu.example.com

# Store these outside the repository. The *_FILE variants avoid putting
# credentials in a systemd Environment= line or in process arguments.
# Client IDs are not secrets; keep the value here or inject it separately.
OAUTH2_PROXY_CLIENT_ID=replace-with-github-client-id
OAUTH2_PROXY_CLIENT_SECRET_FILE=/etc/owu/oauth2-proxy.client-secret
OAUTH2_PROXY_COOKIE_SECRET_FILE=/etc/owu/oauth2-proxy.cookie-secret

# GitHub OAuth provider. Replace the org/team with the organization that owns
# the OWU operators. Leave github_team empty to allow the whole organization.
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_GITHUB_ORG=replace-with-your-github-org
OAUTH2_PROXY_GITHUB_TEAM=

# Session and header behavior for Nginx auth_request.
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_REFRESH=1h
OAUTH2_PROXY_COOKIE_EXPIRE=8h
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_USER_HEADERS=false
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_FORCE_HTTPS=true

# For a generic OIDC provider instead of GitHub, replace the provider block
# above with the following values and remove the GITHUB_* restrictions:
# OAUTH2_PROXY_PROVIDER=oidc
# OAUTH2_PROXY_PROVIDER_DISPLAY_NAME=Your identity provider
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://id.example.com/realms/owu
# OAUTH2_PROXY_SCOPE=openid profile email groups
# OAUTH2_PROXY_ALLOWED_GROUPS=owu-operators

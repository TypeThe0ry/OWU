# Keep this file 0600. Generate a key independent from Nginx Basic Auth:
#   openssl rand -base64 48
# Public 443/80/8080/8443/9443 TLS listeners live in nginx-owu*.conf. The Go
# service stays loopback-only and must not be exposed directly on those ports.
OWU_TUNNEL_KEY=replace-with-a-random-tunnel-key-at-least-20-characters

# Reuse upstream HTTP/2/TLS connections across Bilibili/Douyin assets while
# bounding file descriptors. Set the cache age to "off" to disable Go's
# browser/Nginx public-media cache signal without changing Nginx routes.
OWU_TRANSPORT_POOL_SIZE=64
OWU_MEDIA_CACHE_MAX_AGE=15m

# Resource IDs are fixed server-side. The client never supplies a host or port.
OWU_TCP_RESOURCES=ssh=127.0.0.1:22,minecraft=mc.example.net:25565

# Anonymous usage statistics. Visitors are identified only by a salted hash of
# their client address; the salt keeps hashes stable across restarts. Generate:
#   openssl rand -base64 24
# The data file lives in /var/lib/owu (see ReadWritePaths in owu-proxy.service).
OWU_STATS_FILE=/var/lib/owu/stats.json
OWU_STATS_SALT=replace-with-a-random-salt

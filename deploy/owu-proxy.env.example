# Keep this file 0600. Generate a key independent from Nginx Basic Auth:
#   openssl rand -base64 48
OWU_TUNNEL_KEY=replace-with-a-random-tunnel-key-at-least-20-characters

# Resource IDs are fixed server-side. The client never supplies a host or port.
OWU_TCP_RESOURCES=ssh=127.0.0.1:22,minecraft=mc.example.net:25565
